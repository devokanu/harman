# Gerçek değerleri yalnız .env dosyasına yaz; .env ve kayitlar/ .gitignore'dadır. Buraya değer yazma.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVEN_SES_ID=
ELEVEN_OTURUM_SINIRI=20000
# Oturum başına en çok LLM çağrısı; aşılınca hazır cevap (harcama tavanı)
LLM_OTURUM_SINIRI=1500
# Beyin modeli adları: güncel ve ucuz olanı resmî fiyat sayfasından seç (ai.google.dev/pricing, console.groq.com/docs/models, openrouter.ai/models)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=
# Ses: eleven | piper | yok
SES=yok
PIPER_MODEL=tr_TR-fahrettin-medium.onnx
# 1 = hiçbir ücretli servis çağrılmaz; beyin hazır cevap, ses yalnız önbellek
TEST_MODU=1
KOPRU_WS=ws://localhost:8787
